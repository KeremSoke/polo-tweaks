#: data/org.mate.PoloTweaks.desktop:4
msgid "Compositor Settings"
msgstr "Görüntü Yönetimi Ayarları"

#: data/org.mate.PoloTweaks.desktop:5
msgid "Configure Polo's effects, desktop cube, Expo and shortcuts"
msgstr "Polo'nun görsel özelliklerini, masaüstü küpünü, Expo'yu ve kısayolları yapılandırın"

#: data/org.mate.PoloTweaks.desktop:10
msgid "polo;effects;cube;expo;wobbly;animations;shortcuts;compositor;"
msgstr "polo;efektler;küp;expo;sallanan;animasyonlar;kısayollar;birleştirici;"

